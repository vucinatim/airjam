DATABASE_URL=
NEXT_PUBLIC_AIR_JAM_APP_ID=
AIR_JAM_MASTER_KEY=
NEXT_PUBLIC_AIR_JAM_SERVER_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Operational reliability and launch-critical synthetics
AIRJAM_OPERATIONAL_ENVIRONMENT=development
AIRJAM_SYNTHETIC_HOSTED_RELEASE_URL=
AIRJAM_SYNTHETIC_WORKER_ORIGIN=
AIRJAM_SYNTHETIC_BROWSER_WORKER_ORIGIN=
AIRJAM_SYNTHETIC_APP_ID=
AIRJAM_PLATFORM_WORKER_EVENT_DELIVERY_MS=1000
AIRJAM_PLATFORM_WORKER_SYNTHETIC_MS=30000
AIRJAM_PLATFORM_WORKER_ISSUE_PROJECTION_MS=5000
AIRJAM_PLATFORM_WORKER_TELEMETRY_RETENTION_MS=900000
# Local and preview processes do not claim budget authority by default. A
# production worker must enable this and receive exact project/environment ids
# plus a sealed RAILWAY_PROJECT_TOKEN from Railway.
AIRJAM_PLATFORM_WORKER_BUDGET_REFRESH_MODE=disabled
AIRJAM_PLATFORM_WORKER_BUDGET_REFRESH_MS=900000
# Operational-worker only: repository-installed GitHub App with Issues write.
AIRJAM_GITHUB_ISSUES_APP_ID=
AIRJAM_GITHUB_ISSUES_INSTALLATION_ID=
AIRJAM_GITHUB_ISSUES_PRIVATE_KEY=
AIRJAM_GITHUB_ISSUES_REPOSITORY=
AIR_JAM_RUNTIME_ERROR_REPORT_RATE_LIMIT_MAX=30

# Hosted release serving and artifact storage
# Required to enable hosted release delivery. Use a dedicated cookieless site,
# never the authenticated platform site or one of its sibling subdomains.
# Air Jam production: https://games.air-jam.app
AIRJAM_RELEASES_PUBLIC_ORIGIN=
AIRJAM_RELEASES_R2_BUCKET=
AIRJAM_RELEASES_R2_ACCOUNT_ID=
# AIRJAM_RELEASES_R2_ENDPOINT=
AIRJAM_RELEASES_R2_ACCESS_KEY_ID=
AIRJAM_RELEASES_R2_SECRET_ACCESS_KEY=
AIRJAM_RELEASES_UPLOAD_URL_TTL_SECONDS=900

# Hosted release moderation
AIRJAM_RELEASES_INTERNAL_ACCESS_TOKEN=
# Set one of the browser launch options below.
# AIRJAM_RELEASES_BROWSER_WS_ENDPOINT=
# AIRJAM_RELEASES_BROWSER_ACCESS_TOKEN=
# AIRJAM_RELEASES_BROWSER_EXECUTABLE_PATH=
AIRJAM_RELEASES_IMAGE_MODERATION_MODE=openai
OPENAI_API_KEY=
AIRJAM_RELEASES_OPENAI_MODERATION_MODEL=omni-moderation-latest
AIRJAM_RELEASES_OPENAI_TIMEOUT_MS=20000
AIRJAM_RELEASES_BROWSER_NAVIGATION_TIMEOUT_MS=20000
AIRJAM_RELEASES_BROWSER_WAIT_AFTER_LOAD_MS=1000
AIRJAM_RELEASES_BROWSER_VIEWPORT_WIDTH=1440
AIRJAM_RELEASES_BROWSER_VIEWPORT_HEIGHT=900

# Local Arcade reference games for development only.
# By default, the local Arcade catalog exposes Air Capture at http://127.0.0.1:5173.
# Switch the default entry with:
# NEXT_PUBLIC_AIR_JAM_LOCAL_REFERENCE_DEFAULT=pong
# Or expose additional local games on explicit URLs:
# NEXT_PUBLIC_AIR_JAM_LOCAL_REFERENCE_AIR_CAPTURE_URL=http://127.0.0.1:5173
# NEXT_PUBLIC_AIR_JAM_LOCAL_REFERENCE_PONG_URL=http://127.0.0.1:4173
