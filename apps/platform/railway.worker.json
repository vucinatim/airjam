{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/apps/platform/Dockerfile",
    "watchPatterns": [
      "/apps/platform/**",
      "/packages/database-contract/**",
      "/packages/env/**",
      "/packages/operations-contract/**",
      "/packages/sdk/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "node /app/apps/platform/run-operational-job-worker.mjs",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
